# Copy this file to .env and fill in your real values.
# .env should NOT be committed to git.

# LAN address of your ESP32 (from its serial output on boot)
ESP32_URL=http://192.168.1.50

# Must match the API_KEY constant in your ESP32 firmware
ESP32_API_KEY=change-me-to-something-random

# How often the backend polls the ESP32, in seconds
POLL_INTERVAL_SECONDS=30

# How long readings are kept in the database before pruning
HISTORY_RETENTION_DAYS=30

# From Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel
# -> "Install and run a connector" step. It's a long string, not a URL.
CLOUDFLARE_TUNNEL_TOKEN=
